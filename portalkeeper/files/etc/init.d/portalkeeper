#!/bin/sh /etc/rc.common
# 校园网认证守护 procd 服务
# 启用开关 = UCI main.enabled(由 LuCI「保存并应用」写入);
# 开机时 rc.d 链接调用 start, start_service 内按 enabled 门控是否真正启动。

START=99
STOP=10
USE_PROCD=1

# 与守护进程写同一个日志文件(/tmp tmpfs, 不落闪存), 格式保持一致,
# 这样界面上的日志能看到完整生命周期: 启动 / 停止 / 未启用
log_line() {
	printf '[%s] %s\n' "$(date '+%F %T')" "$1" >> /tmp/portalkeeper.log
}

start_service() {
	local enabled
	config_load portalkeeper
	config_get_bool enabled main enabled 0
	if [ "$enabled" != "1" ]; then
		log_line "服务未启动: 总开关处于关闭状态(勾选「启用」并保存应用后即可启动)"
		return 0
	fi
	if [ ! -x /usr/bin/portalkeeperd ]; then
		log_line "服务启动失败: /usr/bin/portalkeeperd 不存在或没有执行权限"
		return 0
	fi

	# 必需参数只有账号 + 密码(其余都可留空: 网卡留空自动检测, 间隔/次数留空用默认值)。
	# 缺了就不启动, 并把缺什么写进日志 —— 这样清空自己的设置不会被表单拦住,
	# 也不会出现"服务在跑但其实什么都没做"的迷惑状态。
	local username password missing
	config_get username main username
	config_get password main password
	[ -n "$username" ] || missing="账号(username)"
	[ -n "$password" ] || missing="${missing:+$missing + }密码(password)"
	if [ -n "$missing" ]; then
		log_line "服务未启动: 缺少必需配置 $missing —— 填充: LuCI「概览 → 认证服务」, 或 uci set portalkeeper.main.username=… / password=… 后 uci commit portalkeeper"
		return 0
	fi

	procd_open_instance
	procd_set_param command /usr/bin/portalkeeperd daemon
	procd_set_param respawn 3600 5 0
	procd_set_param stdout 1
	procd_set_param stderr 1
	procd_close_instance
}

# rc.common 的 stop() 会先调用本函数、再下发 SIGTERM(见 /etc/rc.common),
# 所以这条记录一定早于守护进程自己的「退出」记录, 重启时也不会与「服务启动」乱序。
# 守护进程本来就没运行时不记录, 免得纯开关场景刷出误导性的停止记录。
stop_service() {
	pidof portalkeeperd >/dev/null 2>&1 && \
		log_line "服务停止: 收到停止请求(停止或重启), 正在关闭守护进程"
	return 0
}

reload_service() {
	stop
	start
}

service_triggers() {
	procd_add_reload_trigger portalkeeper
}